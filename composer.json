{
    "name": "webware/webware-configmanager",
    "description": "Nested object property based access to configuration data, with pluggable readers, writers and processors.",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "config",
        "configuration"
    ],
    "homepage": "https://github.com/orgs/webinertia/discussions",
    "support": {
        "issues": "https://github.com/webinertia/webware-configmanager/issues",
        "chat": "https://discord.gg/9TxQ74EPsG"
    },
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.4.1 || ~8.5.0",
        "ext-json": "*",
        "laminas/laminas-stdlib": "^3.20",
        "psr/container": "^1.0 || ^2.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "laminas/laminas-filter": "^2.41",
        "laminas/laminas-i18n": "^2.30",
        "laminas/laminas-servicemanager": "^3.23",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.3.0",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "symfony/yaml": "^7.4 || ^8.0",
        "webware/webware-tools": "^1.0.0-rc.14"
    },
    "suggest": {
        "laminas/laminas-filter": "Install to use the Filter processor",
        "laminas/laminas-i18n": "Install to use the Translator processor",
        "laminas/laminas-servicemanager": "Install if you need an extensible plugin manager for use with the Config Factory"
    },
    "autoload": {
        "psr-4": {
            "Webware\\ConfigManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTest\\ConfigManager\\": "test/unit/",
            "WebwareTestIntegration\\ConfigManager\\": "test/integration/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true,
            "laminas/laminas-component-installer": true
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-html coverage/html --coverage-text",
        "test-integration": "phpunit --no-coverage --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection",
        "test-all": "@test && @test-integration && @mutation-test"
    }
}